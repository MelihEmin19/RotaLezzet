# Kopyalayın: cp .env.example .env  (Windows: copy .env.example .env)

# Ngrok v2 kırıldığı için tunnel: npm run start:tunnel  veya aşağıdaki satırı .env'e ekleyin
# EXPO_FORCE_WEBCONTAINER_ENV=1

EXPO_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Places anahtarı istemcide KULLANILMAZ.
# Supabase Dashboard → Edge Functions → Secrets → GOOGLE_PLACES_API_KEY
